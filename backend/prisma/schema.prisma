generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ─── Admin users (dashboard login) ───────────────────────
model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("staff") // 'admin' | 'staff'
  createdAt    DateTime @default(now()) @map("created_at")

  assignedCustomers Customer[]
  notifications     Notification[]
  broadcasts        Broadcast[]

  @@map("admins")
}

// ─── Customers / Leads (from LINE OA) ────────────────────
model Customer {
  id            String    @id @default(uuid())
  lineUserId    String    @unique @map("line_user_id")
  displayName   String?   @map("display_name")
  pictureUrl    String?   @map("picture_url")
  phone         String?
  email         String?
  status        String    @default("new_lead") // new_lead, contacted, qualified, customer, closed_lost
  source        String?   @default("line_oa")
  assignedToId  String?   @map("assigned_to")
  notes         String?
  lastMessageAt DateTime? @map("last_message_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  assignedTo    Admin?          @relation(fields: [assignedToId], references: [id])
  conversations Conversation[]
  customerTags  CustomerTag[]
  notifications Notification[]
  broadcastLogs BroadcastLog[]

  @@index([status])
  @@index([lastMessageAt(sort: Desc)])
  @@map("customers")
}

// ─── Conversations (chat sessions) ───────────────────────
model Conversation {
  id         String    @id @default(uuid())
  customerId String    @map("customer_id")
  status     String    @default("active") // active, closed
  handledBy  String    @default("bot") @map("handled_by") // 'bot' | 'human'
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([customerId])
  @@map("conversations")
}

// ─── Messages ────────────────────────────────────────────
model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderType     String   @map("sender_type") // 'customer' | 'bot' | 'admin'
  senderId       String?  @map("sender_id")   // admin.id when sender_type = 'admin'
  messageType    String   @default("text") @map("message_type") // text, image, sticker, file
  content        String
  lineMessageId  String?  @map("line_message_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── Tags ────────────────────────────────────────────────
model Tag {
  id    String @id @default(uuid())
  name  String @unique
  color String @default("#808080") // hex color for dashboard display

  customerTags CustomerTag[]
  broadcasts   Broadcast[]

  @@map("tags")
}

// ─── Customer ↔ Tag (many-to-many) ───────────────────────
model CustomerTag {
  customerId String   @map("customer_id")
  tagId      String   @map("tag_id")
  taggedAt   DateTime @default(now()) @map("tagged_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tags")
}

// ─── Notifications ───────────────────────────────────────
model Notification {
  id         String   @id @default(uuid())
  customerId String?  @map("customer_id")
  adminId    String?  @map("admin_id") // NULL = notify all admins
  type       String   // new_lead, needs_human, follow_up_due
  message    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  admin    Admin?    @relation(fields: [adminId], references: [id])

  @@index([adminId, isRead])
  @@map("notifications")
}

// ─── Broadcasts ──────────────────────────────────────────
model Broadcast {
  id          String   @id @default(uuid())
  title       String
  content     String
  targetTagId String?  @map("target_tag_id")
  sentById    String?  @map("sent_by")
  createdAt   DateTime @default(now()) @map("created_at")

  targetTag     Tag?           @relation(fields: [targetTagId], references: [id])
  sentBy        Admin?         @relation(fields: [sentById], references: [id])
  broadcastLogs BroadcastLog[]

  @@map("broadcasts")
}

// ─── Broadcast Logs ──────────────────────────────────────
model BroadcastLog {
  id          String   @id @default(uuid())
  broadcastId String   @map("broadcast_id")
  customerId  String   @map("customer_id")
  status      String   @default("sent") // sent, failed
  sentAt      DateTime @default(now()) @map("sent_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("broadcast_logs")
}
